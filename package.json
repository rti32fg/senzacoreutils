{
  "name":
    "senzacoreutils",
  "version":
    "1.0.5",
  "description":
    "Javascript partial port of GNU Coreutils.",
  "bin": {
    "du":
      "./du",
    "du.js":
      "./du",
    "sha256sum":
      "./sha256sum",
    "sha256sum.js":
      "./sha256sum"
  },
  "main":
    "libsha256sum",
  "type":
    "module",
  "files": [
    "COPYING",
    "README.md",
    "du",
    "dist",
    "eslint.config.mjs",
    "libsha256sum",
    "sha256sum",
    "test.mjs"
  ],
  "keywords": [
    "coreutils",
    "du",
    "dogeos",
    "gnu",
    "sha256",
    "sha256sum",
    "checksum"
  ],
  "homepage":
    "https://github.com/themartiancompany/senzacoreutils",
  "author": {
    "name": "Pellegrino Prevete",
    "email": "pellegrinoprevete@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/themartiancompany/senzacoreutils.git"
  },
  "license": "AGPL3",
  "bugs": {
    "url":
      "http://github.com/themartiancompany/senzacoreutils/issues",
    "email":
      "dvorak@0x87003Bd6C074C713783df04f36517451fF34CBEf"
  },
  "yargs": {
    "parse-numbers":
      false,
    "parse-positional-numbers":
      false
  },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details; for _app in evm-contract-call evm-contract-deployment-address evm-contract-deployment-abi evm-contract-deployment-bytecode evm-contract-deployment-compiler-output evm-contract-deployment-deployment-networks evm-contract-deployment-versions evm-contract-deployments-dir evm-contracts-tools; do cp 'fs-worker.js' \"dist/${_app}\"; cp 'fs-worker.js' \"dist/lib${_app}\" || true; done",
    "build-libsha256sum":
      "npx webpack --mode 'production' --config 'libsha256sum.webpack.config.cjs' --stats-error-details && mv -v 'libsha256sum.js' 'dist/libsha256sum'",
    "build-du":
      "_app='du'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-sha256sum":
      "_app='sha256sum'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-lib":
      "for _app in sha256sum; do npm run \"build-lib${_app}\"; done",
    "build-bin":
      "for _app in sha256sum; do npm run \"build-${_app}\"; done",
    "build":
      "npm run lint; npm run build-fs-worker; npm run build-lib; npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm run build-man && npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/sha256sum'",
    "test":
      "standard && node test.mjs"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^1000000000000019.1000000000000001.1000000000000001",
    "tmcfs":
      "npm:@themartiancompany/fs@^0.0.27"
  },
  "devDependencies": {
    "browserify-sign":
      "^4.2.6",
    "crash-js-webpack":
      "^0.0.83",
    "crypto-browserify":
      "^3.12.1",
    "eslint":
      "^10.14.0",
    "glob":
      "^14.0.3",
    "globals":
      "^17.3.0",
    "@eslint/config-array":
      "^0.23.5",
    "@eslint/object-schema":
      "^3.0.5",
    "@eslint/js":
      "^10.0.1",
    "minimatch":
      "^11.0.4",
    "rimraf":
      "^6.1.4",
    "safely-serve":
      "^0.0.25",
    "standard":
      "^17.1.2",
    "stream-browserify":
      "^3.0.0",
    "vm-browserify":
      "^1.1.2",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "overrides": {
    "compression":
      "^1.8.2",
    "eslint":
      "^10.14.0",
    "glob":
      "^14.0.3",
    "@eslint/config-array":
      "^0.23.5",
    "@eslint/object-schema":
      "^3.0.5",
    "minimatch":
      "^11.0.4",
    "rimraf":
      "^6.1.4"
  }
}
