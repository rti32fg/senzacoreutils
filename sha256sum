async function
  _overrides_set() {
  let
    _msg;
  _override_set(
    "call",
    "date",
    _get_date_human());
  _override_set(
    "lock",
    "only",
    "n");
  _override_set(
    "config",
    "dir",
    _path_join([
      _homedir_get(),
      ".config",
      "evmfs"]));
  _override_set(
    "cache",
    "dir",
    _path_join([
      _homedir_get(),
      ".cache",
      "evmfs"]));
  _override_set(
    "rpc",
    "selection",
    "kirsh");
  _override_set(
    "chunk",
    "length",
    "22000");
  _override_set(
    "call",
    "method",
    "standalone");
  _override_set(
    "encoding",
    "skip",
    "n");
  _tasks_parallel_auto_detect();
  _override_set(
    "user",
    "level",
    "n");
  _override_set(
    "wallet",
    "name",
    "default");
  _call_timeout_auto_detect();
  _override_set(
    "encoding",
    "type",
    "sha256sum");
  _override_set(
    "retries",
    "max",
    3);
  _call_auth_auto_detect();
  _input_files_auto_detect();
  try {
    _input_uris_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error detecting input file.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  try { 
    _output_files_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error detecting output file.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  const
    _app_name =
      _get(
        "app",
        "name");
  try {
    await _libevm_app_overrides_set(
      "evmfs");
  }
  catch(
    _error) {
    _msg =
      "Error auto-detecting " +
      "LibEVM application variables.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  try {
    await _contracts_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error running '_contracts_auto_detect'.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  const
    _call_auth =
      _get(
        "call",
        "auth");
  const
    _target_networks =
      _get(
        "target",
        "networks");
  _override_set(
    "index",
    "network",
    _target_networks[
      0]);
  if ( _call_auth == "y" ) {
    const
      _wallet_name =
        _get(
          "wallet",
          "name");
    const
      _wallet_overrides_set_args = [
        "evm-wallet",
        _wallet_name,
        _call_auth,
        "n",               // QR support
        _target_networks
      ];
    const
      _wallet_overrides_set_up =
        await _wallet_overrides_set.apply(
          null,
          _wallet_overrides_set_args);
  }
  else if ( _call_auth == "n" ) {
    true;
  }
  else {
    _msg =
      `Unknown value '${_call_auth}' ` +
      "for 'call_auth' variable.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

function
  _usage(
    _exit_code) {
  let
    _line,
    _target_networks;
  const
    _program =
      _basename(
        _argv[
          0]);
  if ( target_networks.length < 1 ) {
    _target_networks =
      "All those supported by " +
      "EVM Chains Info.";
  }
  else {
    _target_networks =
      _get(
        "target",
        "networks");
  }
  const
    _text = [
      "",
      "Print or check SHA256 (256-bit) checksums.",
      "",
      "Usage:",
      `  ${_program}`,
      "    [options]",
      "    [file]",
      "",
      "  options:",
      "",
      "    -h, --help",
      "",
      "      This message.",
      "",
      "    -c, --color",
      "",
      "      Enable color output.",
      "",
      "    -v, --verbose",
      "",
      "      Enable verbose output.",
      "",
    ];
  for ( _line of _text ) {
    _echo(
      _line);
  }
  _exit(
    _exit_code);
}

function
  _config_show() {
  let
    _item,
    _line,
    _text;
  const
    _program =
      _basename(
        _argv[
          0]);
  _text = [
    `${_program} configuration:`,
    `                       Call date:   ${call_date}`,
    `             Runtime environment:   ${runtime_environment}`,
    `                    Target files:`,
  ];
  for ( _item of target_files ) {
    _text.push(
      `                                    ${_item}`);
  }
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

async function
  _main() {
  let
    _file,
    _msg,
    _result,
    _results;
  try {
    const
      _overrides_set_up =
        await _overrides_set();
  }
  catch(
    _error) {
    _msg =
      "Error setting overrides.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  _config_show();
  const
    app_opts = [
      target_files
    ];
  
  try {
    _for ( _file of _target_files ) {
      _result =
        await _sha256sum.apply(
          null,
          app_opts);
    }
  }
  catch(
    _error) {
    _msg =
      "Error running '_sha256sum' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      app_opts);
    _echo2(
      _error);
    throw _error;
  }
  const
    _results_type =
      typeof(
        _results);
  if ( _results_type == "bigint" ) {
    _echo(
      _results.toString());
  }
  else if ( _results_type == "string" ) {
    _echo(
      _results);
  }
  else if ( _results_type == "object" ) {
    for ( _result of _results ) {
      _echo(
        _result);
    }
  }
  else if ( _results_type == "undefined" ) {
    _msg =
      `No results.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  else {
    _msg =
      "Error retrieving results for command. " +
      `Type of return: '${_results_type}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

async function 
  _cmdline_parse() {
  let
    _help_display,
    _output_files;
  const
    _global =
      _global_get();
  const
    _argv_args = {
      "booleans": [
        "h",
        "help",
        "Q",
        "with-colons",
        "v",
        "verbose"
      ],
      "string":
        true
    };
  const
    _argv =
      await _argv_get(
        _argv_args);
  const
    _options =
      _argv[
        "_"];
  _global[
    "quiet"] = 
    "y";
  runtime_environment =
    "node";
  if ( _argv[
         "v"] ||
       _argv[
         "verbose"]) {
    _global[
      "verbose"] =
      true;
  }
  if ( _global[
         "verbose"] ) {
    _global[
      "quiet"] =
      "n";
  }
  if ( _argv[
         "h"] ||
       _argv[
         "help"] ) {
    _help_display =
      true;
  }
  if ( _help_display ) {
    _global[
      "quiet"] =
      "n";
    await _overrides_set();
    _usage(
      0);
  }
  const
    _argv_type =
      typeof(
        _argv); // why
  if ( _argv_type !== "undefined" &&
       0 < _argv[
             "_"].length ) {
    _set(
      "target",
      "command",
      _argv[
        "_"][
          0]);
  }
  if ( _argv_type !== "undefined" &&
       1 < _argv[
             "_"].length ) {
    _set(
      "target",
      "key",
      _argv[
        "_"][
          1]);
  }
  if ( typeof(
       _argv) != "undefined" &&
       2 < _argv[
             "_"].length ) {
    _set(
      "target",
      "value",
      _argv[
        "_"][
          2]);
  }
  if ( typeof(
       _argv) != "undefined" &&
       3 < _argv[
             "_"].length ) {
    const
      _command_args =
        _argv[
          "_"].slice(
          3,
          _argv.length);
    _set(
      "command",
      "args",
      _command_args);
  }
  if ( "m" in _argv ) {
    _set(
      "call",
      "method",
      _argv[
        "m"]);
  }
  if ( "call-method" in _argv ) {
    _set(
      "call",
      "method",
      _argv[
        "call-method"]);
  }
  if ( "r" in _argv ) {
    _set(
      "retries",
      "max",
      _argv[
        "r"]);
  }
  if ( "retries-max" in _argv ) {
    _set(
      "retries",
      "max",
      _argv[
        "retries-max"]);
  }
  if ( "T" in _argv ) {
    _set(
      "call",
      "timeout",
      _argv[
        "T"]);
  }
  if ( "call-timeout" in _argv ) {
    _set(
      "call",
      "timeout",
      _argv[
        "call-timeout"]);
  }
  if ( "l" in _argv ) {
    _set(
      "chunk",
      "length",
      _argv[
        "l"]);
  }
  if ( "chunk-length" in _argv ) {
    _set(
      "chunk",
      "length",
      _argv[
        "chunk-length"]);
  }
  if ( "L" in _argv ) {
    _set(
      "lock",
      "only",
      "y");
  }
  if ( "lock-only" in _argv ) {
    _set(
      "lock",
      "only",
      "y");
  }
  if ( "P" in _argv ) {
    _set(
      "tasks",
      "parallel",
      _argv[
        "P"]);
  }
  if ( "tasks-parallel" in _argv ) {
    _set(
      "tasks",
      "parallel",
      _argv[
        "P"]);
  }
  if ( "i" in _argv ) {
    _set(
      "index",
      "network",
      _argv[
        "i"]);
  }
  if ( "qr-support" in _argv ) {
    _set(
      "index",
      "network",
      _argv[
        "index-network"]);
  }
  _output_files =
    _get(
      "output",
      "files");
  if ( "o" in _argv ) {
    const
      _output_files_argv_type =
        typeof(
          _argv[
            "o"]);
    if ( _output_files_argv_type === "string" ||
         _output_files_argv_type === "number" ) {
      _output_files.push(
        _argv[
          "o"]);
    }
    else if ( _output_files_argv_type === "object" ) {
      _output_files =
        _output_files.concat(
        _argv[
          "o"]);
    }
  }
  if ( "output-file" in _argv ) {
    const
      _output_files_argv_type =
        typeof(
          _argv[
            "output-file"]);
    if ( _output_files_argv_type === "string" ||
         _output_files_argv_type === "number" ) {
      _output_files.push(
        _argv[
          "output-file"]);
    }
    else if ( _output_files_argv_type === "object" ) {
      _output_files =
        _output_files.concat(
        _argv[
          "output-file"]);
    }
  }
  _set(
    "output",
    "files",
    _output_files);
  if ( "W" in _argv ) {
    _set(
      "cache",
      "dir",
      _argv[
        "W"]);
  }
  if ( "cache-dir" in _argv ) {
    _set(
      "cache",
      "dir",
      _argv[
        "cache-dir"]);
  }
  _libevm_cmdline_parse(
    _argv);
}

function
  _url_parse() {
  const
    _argv =
      _argv_url_get();
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    _argv_url_get(
      "quiet");
  if ( _global[
         "quiet"].length === 0 ) {
    _global[
      "quiet"] =
      "n";
  }
}

_global_variables();
if ( await _cmdline_check(
       "sha256sum.js") ||
     await _cmdline_check(
       "sha256sum") ) {
  const
    _msg =
      "Running 'sha256sum' from the command line.";
  _echo(
    _msg);
  await _cmdline_parse();
}
else {
  const
    _msg =
      "Running 'sha256sum' from a web browser.";
  _echo(
    _msg);
  _url_parse();
}
try {
  _main();
}
catch(
  _error) {
  const
    _msg =
      "Error running '_main'.";
  _echo2(
    _error);
  _exit(
    1);
}
