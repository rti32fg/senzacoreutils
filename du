const
  _libcrash =
    await import(
      "libcrash-js");
/* global
     _argv */
const
  _argv =
    _libcrash._argv;
/* global
     _argv_get */
const
  _argv_get =
    _libcrash._argv_get;
/* global
     _argv_url_get */
const
  _argv_url_get =
    _libcrash._argv_url_get;
/* global
     _basename */
const
  _basename =
    _libcrash._basename;
/* global
     _cmdline_check */
const
  _cmdline_check =
    _libcrash._cmdline_check;
/* global
     _du */
const
  _du =
    _libcrash._du;
/* global
     _echo */
const
  _echo =
    _libcrash._echo;
/* global
     _echo2 */
const
  _echo2 =
    _libcrash._echo2;
/* global
     _exit */
const
  _exit =
    _libcrash._exit;
/* global
     _file_exists */
const
  _file_exists =
    _libcrash._file_exists;
/* global
     _get */
const
  _get =
    _libcrash._get;
/* global
     _get_date_human */
const
  _get_date_human =
    _libcrash._get_date_human;
/* global
     _global_get */
const
  _global_get =
